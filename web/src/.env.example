FIREBASE_API_KEY=replace-with-firebase-web-api-key
GOOGLE_OAUTH_CLIENT_ID=replace-with-web-oauth-client-id.apps.googleusercontent.com
# Some Google OAuth clients require this during token exchange.
GOOGLE_OAUTH_CLIENT_SECRET=
# Add this exact URI to the Web OAuth client's authorized redirect URIs.
# http://127.0.0.1:45678
