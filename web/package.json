{
  "name": "quotes-database-admin-panel",
  "productName": "Quotes Database Admin Panel",
  "version": "1.0.0",
  "description": "Purpose-built admin panel for managing quotes database.",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "test": "npm run test:node && npm run test:rules",
    "test:node": "node --test test/google-oauth.test.js",
    "test:rules": "firebase emulators:exec --project demo-quotes-owner-rules --only firestore \"node --test test/firestore-rules.test.js\""
  },
  "keywords": [],
  "author": {
    "name": "Joshua S.",
    "email": "johnsilverknight@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@reforged/maker-appimage": "^5.3.1",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.3.0",
    "firebase-tools": "^15.31.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4"
  },
  "dependencies": {
    "difflib": "^0.2.4",
    "dotenv": "^17.4.2",
    "electron-squirrel-startup": "^1.0.1",
    "firebase": "^12.19.0"
  }
}
